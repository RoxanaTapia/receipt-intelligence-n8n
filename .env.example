# Copy to .env and adjust values before running: cp .env.example .env

# n8n server
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin

# Basic auth (recommended for local self-hosted n8n)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# Anthropic API (local only — used by Claude nodes in n8n workflows)
ANTHROPIC_API_KEY=

# Sibling FastAPI (Module 5+) — base URL for analytics/Q&A HTTP calls (not receipt upload)
# n8n runs in Docker: use host.docker.internal so the container can reach the API on your Mac.
# From a browser or terminal on the host, use http://localhost:8000 instead.
# Compose sets N8N_BLOCK_ENV_ACCESS_IN_NODE=false so workflow expressions can use $env.API_BASE_URL.
API_BASE_URL=http://host.docker.internal:8000
