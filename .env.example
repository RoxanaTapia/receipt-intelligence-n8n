# Copy to .env and adjust values before running: cp .env.example .env

# n8n server
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Berlin

# Basic auth (recommended for local self-hosted n8n)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-to-a-strong-password

# Anthropic API (local only — used by Claude nodes in n8n workflows)
ANTHROPIC_API_KEY=
